@startuml LockerKorea_ClassDiagram

skinparam classAttributeIconSize 0
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam classArrowColor Black

' --- CORE ENTITIES ---
class User {
    -userId : Long
    -email : String
    -password : String
    -fullName : String
    -role : String
}

class Product {
    -productId : Long
    -productName : String
    -price : Double
    -stock : int
}

class ProductImage {
    -imageId : Long
    -imageUrl : String
}

class Category {
    -categoryId : Long
    -categoryName : String
}

class LockFeature {
    -featureId : Long
    -featureName : String
}

' --- ORDER & PAYMENT ---
class Order {
    -orderId : Long
    -orderDate : Date
    -totalAmount : Double
    -status : String
}

class OrderDetail {
    -id : Long
    -quantity : int
    -price : Double
}

class Voucher {
    -voucherId : Long
    -code : String
    -value : Double
    -expiryDate : Date
}

class ReturnRequest {
    -requestId : Long
    -reason : String
    -status : String
}

' --- CONTENT & MARKETING ---
class News {
    -newsId : Long
    -title : String
    -content : String
    -publishDate : Date
}

class Banner {
    -bannerId : Long
    -imageUrl : String
    -linkUrl : String
    -active : boolean
}

' --- INTERACTION ---
class Review {
    -reviewId : Long
    -rating : int
    -comment : String
}

class Notification {
    -id : Long
    -content : String
    -isRead : boolean
}

class Conversation {
    -conversationId : Long
    -status : String
}

class Message {
    -messageId : Long
    -content : String
    -senderType : String
    -timestamp : Date
}

class AIInteractionLog {
    -logId : Long
    -type : String
    -input : String
    -output : String
}

' --- RELATIONSHIPS ---

User "1" *-- "*" Notification : owns
User "1" o-- "*" Order : places
User "1" o-- "*" ReturnRequest : requests
User "1" o-- "*" Review : writes
User "1" o-- "*" AIInteractionLog : interacts
User "1" o-- "*" News : creates (Admin)
User "1" o-- "*" Conversation : participates

Order "1" *-- "*" OrderDetail : contains
Order "1" o-- "0..1" Voucher : uses
Order "1" -- "0..1" ReturnRequest : has

OrderDetail "*" -- "1" Product : refers to

Product "*" -- "1" Category : belongs to
Product "1" *-- "*" ProductImage : has
Product "*" o-- "*" LockFeature : has features
Product "1" o-- "*" Review : has reviews

Conversation "1" *-- "*" Message : contains

@enduml
