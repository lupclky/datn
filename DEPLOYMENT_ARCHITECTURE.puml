@startuml
!theme plain
skinparam componentStyle uml2
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 45

node "<<device>>\nUser Device" as UserDevice {
    node "<<executionEnvironment>>\nWeb Browser" {
        artifact "Angular SPA" as SPA
    }
}

cloud "Cloudflare" as Cloudflare

package "External Services" {
    artifact "Google Cloud Storage" as GCS
    artifact "Google Gemini AI" as Gemini
    artifact "Gmail SMTP" as Gmail
}

cloud "Google Cloud Platform (GCP)" as GCP {
    node "<<device>>\nCompute Engine VM" as VM {
        node "<<executionEnvironment>>\nDocker Engine" as Docker {
            node "<<executionEnvironment>>\nDocker Network\nlockerkorea-network" as Net {
                node "<<device>>\ncloudflared Container" as Cloudflared {
                    artifact "Cloudflare Tunnel Client" as Tunnel
                }

                node "<<device>>\nnginx-proxy Container" as NginxProxy {
                    artifact "nginx-proxy\n(Reverse Proxy)" as Proxy
                }

                node "<<device>>\nFrontend Container" as FrontendNode {
                    node "<<executionEnvironment>>\nNode.js Runtime" {
                        artifact "Angular SSR Server\n(server.mjs)" as FE_SSR
                        artifact "Angular Browser Assets\n(dist/.../browser)" as FE_Assets
                    }
                }

                node "<<device>>\nBackend Container" as BackendNode {
                    node "<<executionEnvironment>>\nSpring Boot Runtime" {
                        artifact "Backend Application" as BackendApp
                    }
                }

                node "<<device>>\nAI Embedding Container" as AINode {
                    node "<<executionEnvironment>>\nPython Runtime" {
                        artifact "FastAPI App" as AIApp
                        artifact "CLIP Model" as AIModel
                    }
                }

                node "<<device>>\nChromaDB Container" as ChromaNode {
                    node "<<executionEnvironment>>\nChromaDB Engine" {
                        artifact "Vector Index" as VectorIndex
                    }
                }

                node "<<device>>\nMySQL Container" as DBNode {
                    node "<<executionEnvironment>>\nMySQL Engine" {
                        artifact "lockerkorea DB" as DB
                    }
                }
            }

            folder "Docker Volumes" {
                artifact "chroma-data" as VolChroma
                artifact "Backend/lockerkorea.sql\n(init.sql)" as InitSQL
            }
        }
    }
}

' Connections (Ingress)
SPA --> Cloudflare : <<HTTPS>>\nLoad SPA / REST API
Cloudflare --> Tunnel : <<Tunnel>>\nIngress
Tunnel --> Proxy : <<HTTP>>\nForward

' Connections (Routing)
Proxy --> FrontendNode : <<HTTP>>\nRoute /
Proxy --> BackendApp : <<HTTP>>\nRoute /api

note right of FrontendNode
    App supports Angular SSR (Node server on port 4000).
    Current DockerfileAngular builds browser-only static output
    (served by Nginx on port 80). If you want SSR in Docker,
    build/copy dist/.../server and run server.mjs.
end note

' Connections (Internal)
BackendApp --> DB : <<TCP:3306>>\nRead/Write
BackendApp --> VectorIndex : <<HTTP:8000>>\nVector Search
BackendApp --> AIApp : <<HTTP:9000>>\nGet Embeddings

FrontendNode -[hidden]- FE_SSR
FrontendNode -[hidden]- FE_Assets

' Connections (External)
BackendApp --> GCS : <<HTTPS>>\nSave Media
BackendApp --> Gemini : <<HTTPS>>\nGenAI
BackendApp --> Gmail : <<SMTP>>\nSend Email

' Persistence notes
VectorIndex ..> VolChroma : persistent
DB ..> InitSQL : init

AIApp -[hidden]- AIModel

@enduml
