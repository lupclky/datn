@startuml LockerKorea_UseCase
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}

actor "Khách hàng (Customer + Guest)" as Customer
actor "Quản trị viên (Admin + Staff)" as Admin
actor "AI Services" as AI

package "Hệ thống Locker Korea" {
    
    ' --- Chung ---
    usecase "Đăng nhập" as UC_Login
    usecase "Đăng xuất" as UC_Logout
    usecase "Đăng ký" as UC_Register
    usecase "Quên mật khẩu" as UC_ForgotPass

    UC_Logout .> UC_Login : <<include>>

    ' --- Khách hàng ---
    usecase "Xem & Tìm kiếm sản phẩm" as UC_ViewProduct
    usecase "Xem Tin tức" as UC_ViewNews
    usecase "Xem chi tiết sản phẩm" as UC_ProductDetail
    usecase "Quản lý Giỏ hàng" as UC_Cart
    usecase "Đặt hàng & Thanh toán" as UC_Order
    usecase "Xem lịch sử mua hàng" as UC_History
    usecase "Yêu cầu Đổi/Trả" as UC_Return
    usecase "Quản lý Hồ sơ cá nhân" as UC_Profile
    usecase "Chat với Nhân viên hỗ trợ" as UC_ChatStaff
    usecase "Viết đánh giá sản phẩm" as UC_CustReview

    UC_Order .> UC_Login : <<include>>
    UC_History .> UC_Login : <<include>>
    UC_Return .> UC_Login : <<include>>
    UC_Profile .> UC_Login : <<include>>
    UC_ChatStaff .> UC_Login : <<include>>
    UC_CustReview .> UC_Login : <<include>>
    UC_ViewProduct <.. UC_ProductDetail : <<extend>>

    ' --- Quản trị viên ---
    usecase "Quản lý Sản phẩm" as UC_ManageProduct
    usecase "Quản lý Danh mục" as UC_ManageCategory
    usecase "Quản lý Đơn hàng" as UC_ManageOrder
    usecase "Quản lý Người dùng" as UC_ManageUser
    usecase "Quản lý Voucher" as UC_ManageVoucher
    usecase "Quản lý Tin tức" as UC_ManageNews
    usecase "Quản lý Banner" as UC_ManageBanner
    usecase "Quản lý Yêu cầu Đổi trả" as UC_ManageReturn
    usecase "Xem Thống kê & Báo cáo" as UC_Stats
    usecase "Hỗ trợ Khách hàng (Chat)" as UC_SupportChat
    usecase "Quản lý Đánh giá" as UC_ManageReview
    usecase "Quản lý Tính năng khóa" as UC_ManageFeature

    UC_ManageProduct .> UC_Login : <<include>>
    UC_ManageOrder .> UC_Login : <<include>>
    UC_Stats .> UC_Login : <<include>>
    UC_SupportChat .> UC_Login : <<include>>

    ' --- AI Features ---
    usecase "Chat tư vấn sản phẩm (AI)" as UC_AIChat
    usecase "Tìm kiếm bằng hình ảnh (AI)" as UC_AIImage
    usecase "Chẩn đoán lỗi khóa (AI)" as UC_AIDiagnose
    usecase "Sinh nội dung tự động (AI)" as UC_AIContent

    ' --- Quan hệ ---
    
    ' Customer relationships
    Customer --> UC_Login
    Customer --> UC_Register
    Customer --> UC_ForgotPass
    Customer --> UC_ViewProduct
    Customer --> UC_ViewNews
    Customer --> UC_Cart
    Customer --> UC_Order
    Customer --> UC_History
    Customer --> UC_Return
    Customer --> UC_Profile
    Customer --> UC_ChatStaff
    Customer --> UC_CustReview
    
    ' Customer - AI interactions
    Customer --> UC_AIChat
    Customer --> UC_AIImage
    Customer --> UC_AIDiagnose

    ' Admin relationships
    Admin --> UC_Login
    Admin --> UC_ManageProduct
    Admin --> UC_ManageCategory
    Admin --> UC_ManageOrder
    Admin --> UC_ManageUser
    Admin --> UC_ManageVoucher
    Admin --> UC_ManageNews
    Admin --> UC_ManageBanner
    Admin --> UC_ManageReturn
    Admin --> UC_Stats
    Admin --> UC_SupportChat
    Admin --> UC_ManageReview
    Admin --> UC_ManageFeature

    ' Admin - AI interactions (AI assists Admin)
    Admin --> UC_AIContent

    ' AI Services executing backend tasks
    AI --> UC_AIChat
    AI --> UC_AIImage
    AI --> UC_AIDiagnose
    AI --> UC_AIContent
}

@enduml
