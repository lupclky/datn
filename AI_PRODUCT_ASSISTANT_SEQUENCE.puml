@startuml
autonumber
actor "Người dùng" as User
participant "Frontend (Angular)\nAiChatbotComponent" as FE
participant "Backend (Spring Boot)\nAIChatController" as BE
participant "AI Service\nAIProductAssistantService" as Service
participant "Vector Search\nVectorSearchService" as Vector
participant "Embedding Service\n(Python/CLIP)" as Embed
participant "ChromaDB\n(Vector Database)" as DB
participant "Google Gemini\n(LangChain4J)" as LLM

note over User, FE: Bắt đầu phiên tư vấn

User -> FE: Nhập câu hỏi (VD: "Khóa vân tay nào tốt?")
FE -> BE: POST /api/v1/ai/chat/product-assistant\n{ "query": "Khóa vân tay nào tốt?" }

activate BE
BE -> Service: answerProductQuery(query)

activate Service
Service -> Vector: searchProducts(query, topK=10)

activate Vector
Vector -> Embed: embed(text)
activate Embed
Embed --> Vector: Trả về Vector Embedding [0.1, 0.5, ...]
deactivate Embed

Vector -> DB: Query(embedding, limit=10)
activate DB
DB --> Vector: Trả về danh sách Documents (Sản phẩm liên quan)
deactivate DB

Vector --> Service: List<Document>
deactivate Vector

alt Không tìm thấy sản phẩm (Vector Search)
    Service -> Service: searchProductsByExactMatch(query)\n(Fallback tìm kiếm theo từ khóa trong DB SQL)
end

Service -> Service: buildProductContext(documents)\n(Tạo ngữ cảnh từ thông tin sản phẩm)

Service -> Service: createEnhancedPrompt(query, context)\n(Ghép câu hỏi + thông tin sản phẩm vào Prompt)

Service -> LLM: chat(prompt)
activate LLM
LLM --> Service: Trả về câu trả lời tư vấn
deactivate LLM

Service --> BE: String response
deactivate Service

BE --> FE: JSON { "response": "...", "success": true }
deactivate BE

FE -> User: Hiển thị câu trả lời của AI
@enduml
