<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1">
  <uml:Model xmi:id="model_lk_v3" name="LockerKorea_Analysis_Model_V3">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_domain_v3" name="DomainModel">
      
      <!-- === CORE ENTITIES === -->
      
      <packagedElement xmi:type="uml:Class" xmi:id="c_user" name="User">
        <ownedAttribute xmi:id="a_u_id" name="userId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_u_email" name="email" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_u_pass" name="password" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_u_name" name="fullName" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_u_role" name="role" visibility="private" type="dt_str"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="c_prod" name="Product">
        <ownedAttribute xmi:id="a_p_id" name="productId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_p_name" name="productName" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_p_price" name="price" visibility="private" type="dt_dbl"/>
        <ownedAttribute xmi:id="a_p_stock" name="stock" visibility="private" type="dt_int"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="c_pimg" name="ProductImage">
        <ownedAttribute xmi:id="a_pi_id" name="imageId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_pi_url" name="imageUrl" visibility="private" type="dt_str"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="c_cat" name="Category">
        <ownedAttribute xmi:id="a_c_id" name="categoryId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_c_name" name="categoryName" visibility="private" type="dt_str"/>
      </packagedElement>

      <!-- === ORDER & PAYMENT === -->

      <packagedElement xmi:type="uml:Class" xmi:id="c_order" name="Order">
        <ownedAttribute xmi:id="a_o_id" name="orderId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_o_date" name="orderDate" visibility="private" type="dt_date"/>
        <ownedAttribute xmi:id="a_o_total" name="totalAmount" visibility="private" type="dt_dbl"/>
        <ownedAttribute xmi:id="a_o_stt" name="status" visibility="private" type="dt_str"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="c_odetail" name="OrderDetail">
        <ownedAttribute xmi:id="a_od_id" name="id" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_od_qty" name="quantity" visibility="private" type="dt_int"/>
        <ownedAttribute xmi:id="a_od_pr" name="price" visibility="private" type="dt_dbl"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="c_voucher" name="Voucher">
        <ownedAttribute xmi:id="a_v_id" name="voucherId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_v_code" name="code" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_v_val" name="value" visibility="private" type="dt_dbl"/>
        <ownedAttribute xmi:id="a_v_exp" name="expiryDate" visibility="private" type="dt_date"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="c_return" name="ReturnRequest">
        <ownedAttribute xmi:id="a_r_id" name="requestId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_r_rea" name="reason" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_r_stt" name="status" visibility="private" type="dt_str"/>
      </packagedElement>

      <!-- === MARKETING & CONTENT === -->

      <packagedElement xmi:type="uml:Class" xmi:id="c_news" name="News">
        <ownedAttribute xmi:id="a_news_id" name="newsId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_news_ti" name="title" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_news_co" name="content" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_news_da" name="publishDate" visibility="private" type="dt_date"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="c_banner" name="Banner">
        <ownedAttribute xmi:id="a_b_id" name="bannerId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_b_img" name="imageUrl" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_b_link" name="linkUrl" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_b_act" name="active" visibility="private" type="dt_bool"/>
      </packagedElement>

      <!-- === INTERACTION & AI === -->

      <packagedElement xmi:type="uml:Class" xmi:id="c_review" name="Review">
        <ownedAttribute xmi:id="a_rv_id" name="reviewId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_rv_rt" name="rating" visibility="private" type="dt_int"/>
        <ownedAttribute xmi:id="a_rv_cmt" name="comment" visibility="private" type="dt_str"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="c_notif" name="Notification">
        <ownedAttribute xmi:id="a_n_id" name="id" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_n_cont" name="content" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_n_read" name="isRead" visibility="private" type="dt_bool"/>
      </packagedElement>
      
      <packagedElement xmi:type="uml:Class" xmi:id="c_conv" name="Conversation">
        <ownedAttribute xmi:id="a_cv_id" name="conversationId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_cv_stt" name="status" visibility="private" type="dt_str"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="c_msg" name="Message">
        <ownedAttribute xmi:id="a_m_id" name="messageId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_m_con" name="content" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_m_sen" name="senderType" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_m_time" name="timestamp" visibility="private" type="dt_date"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="c_ai" name="AI_Log">
        <ownedAttribute xmi:id="a_ai_id" name="logId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_ai_type" name="type" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_ai_in" name="input" visibility="private" type="dt_str"/>
        <ownedAttribute xmi:id="a_ai_out" name="output" visibility="private" type="dt_str"/>
      </packagedElement>
      
      <packagedElement xmi:type="uml:Class" xmi:id="c_feat" name="LockFeature">
        <ownedAttribute xmi:id="a_f_id" name="featureId" visibility="private" type="dt_long"/>
        <ownedAttribute xmi:id="a_f_name" name="featureName" visibility="private" type="dt_str"/>
      </packagedElement>

      <!-- DATA TYPES -->
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_str" name="String"/>
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_int" name="int"/>
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_long" name="Long"/>
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_dbl" name="Double"/>
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_bool" name="boolean"/>
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_date" name="Date"/>

      <!-- RELATIONSHIPS -->

      <!-- User - Notification -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_u_n" memberEnd="end_u_n end_n_u">
        <ownedEnd xmi:id="end_u_n" type="c_user" association="rel_u_n" aggregation="composite"/>
        <ownedEnd xmi:id="end_n_u" type="c_notif" association="rel_u_n"/>
      </packagedElement>

      <!-- User - Order -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_u_o" memberEnd="end_u_o end_o_u">
        <ownedEnd xmi:id="end_u_o" type="c_user" association="rel_u_o" aggregation="shared"/>
        <ownedEnd xmi:id="end_o_u" type="c_order" association="rel_u_o"/>
      </packagedElement>

      <!-- Order - OrderDetail -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_o_od" memberEnd="end_o_od end_od_o">
        <ownedEnd xmi:id="end_o_od" type="c_order" association="rel_o_od" aggregation="composite"/>
        <ownedEnd xmi:id="end_od_o" type="c_odetail" association="rel_o_od"/>
      </packagedElement>

      <!-- Product - OrderDetail -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_p_od" memberEnd="end_p_od end_od_p">
        <ownedEnd xmi:id="end_p_od" type="c_prod" association="rel_p_od"/>
        <ownedEnd xmi:id="end_od_p" type="c_odetail" association="rel_p_od"/>
      </packagedElement>

      <!-- Product - ProductImage -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_p_img" memberEnd="end_p_img end_img_p">
        <ownedEnd xmi:id="end_p_img" type="c_prod" association="rel_p_img" aggregation="composite"/>
        <ownedEnd xmi:id="end_img_p" type="c_pimg" association="rel_p_img"/>
      </packagedElement>

      <!-- Category - Product -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_c_p" memberEnd="end_c_p end_p_c">
        <ownedEnd xmi:id="end_c_p" type="c_cat" association="rel_c_p" aggregation="shared"/>
        <ownedEnd xmi:id="end_p_c" type="c_prod" association="rel_c_p"/>
      </packagedElement>

      <!-- Product - LockFeature -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_p_f" memberEnd="end_p_f end_f_p">
        <ownedEnd xmi:id="end_p_f" type="c_prod" association="rel_p_f"/>
        <ownedEnd xmi:id="end_f_p" type="c_feat" association="rel_p_f"/>
      </packagedElement>

      <!-- Order - Voucher -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_o_v" memberEnd="end_o_v end_v_o">
        <ownedEnd xmi:id="end_o_v" type="c_order" association="rel_o_v"/>
        <ownedEnd xmi:id="end_v_o" type="c_voucher" association="rel_o_v"/>
      </packagedElement>

      <!-- User - ReturnRequest -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_u_r" memberEnd="end_u_r end_r_u">
        <ownedEnd xmi:id="end_u_r" type="c_user" association="rel_u_r" aggregation="shared"/>
        <ownedEnd xmi:id="end_r_u" type="c_return" association="rel_u_r"/>
      </packagedElement>

      <!-- Order - ReturnRequest -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_o_r" memberEnd="end_o_r end_r_o">
        <ownedEnd xmi:id="end_o_r" type="c_order" association="rel_o_r"/>
        <ownedEnd xmi:id="end_r_o" type="c_return" association="rel_o_r"/>
      </packagedElement>

      <!-- User - Review -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_u_rv" memberEnd="end_u_rv end_rv_u">
        <ownedEnd xmi:id="end_u_rv" type="c_user" association="rel_u_rv" aggregation="shared"/>
        <ownedEnd xmi:id="end_rv_u" type="c_review" association="rel_u_rv"/>
      </packagedElement>

      <!-- Product - Review -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_p_rv" memberEnd="end_p_rv end_rv_p">
        <ownedEnd xmi:id="end_p_rv" type="c_prod" association="rel_p_rv" aggregation="shared"/>
        <ownedEnd xmi:id="end_rv_p" type="c_review" association="rel_p_rv"/>
      </packagedElement>
      
      <!-- User - AI_Log -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_u_ai" memberEnd="end_u_ai end_ai_u">
        <ownedEnd xmi:id="end_u_ai" type="c_user" association="rel_u_ai" aggregation="shared"/>
        <ownedEnd xmi:id="end_ai_u" type="c_ai" association="rel_u_ai"/>
      </packagedElement>

      <!-- User - News (Author) -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_u_news" memberEnd="end_u_news end_news_u">
        <ownedEnd xmi:id="end_u_news" type="c_user" association="rel_u_news" aggregation="shared"/>
        <ownedEnd xmi:id="end_news_u" type="c_news" association="rel_u_news"/>
      </packagedElement>

      <!-- User - Conversation -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_u_conv" memberEnd="end_u_conv end_conv_u">
        <ownedEnd xmi:id="end_u_conv" type="c_user" association="rel_u_conv" aggregation="shared"/>
        <ownedEnd xmi:id="end_conv_u" type="c_conv" association="rel_u_conv"/>
      </packagedElement>

      <!-- Conversation - Message -->
      <packagedElement xmi:type="uml:Association" xmi:id="rel_cv_msg" memberEnd="end_cv_msg end_msg_cv">
        <ownedEnd xmi:id="end_cv_msg" type="c_conv" association="rel_cv_msg" aggregation="composite"/>
        <ownedEnd xmi:id="end_msg_cv" type="c_msg" association="rel_cv_msg"/>
      </packagedElement>

    </packagedElement>
  </uml:Model>
</xmi:XMI>







