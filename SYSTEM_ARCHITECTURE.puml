@startuml
!theme plain
skinparam componentStyle rectangle
skinparam linetype polyline
skinparam nodesep 100
skinparam ranksep 80

' Top Level
component "AI Embedding Service\n(Python FastAPI)" as AIServer
cloud "Google Gemini AI" as Gemini
cloud "Gmail SMTP" as Gmail

' Middle Level
actor "User" as User
component "User Web\n(Angular)" as WebUser
component "Backend Service\n(Spring Boot)" as Backend
component "Admin Web\n(Angular)" as WebAdmin
actor "Admin" as Admin

' Bottom Level
database "MySQL" as MySQL
database "ChromaDB\n(Vector Store)" as ChromaDB

' Layout Constraints
AIServer -[hidden]down- Backend
Gemini -[hidden]down- Backend
Gmail -[hidden]down- Backend

Backend -[hidden]down- MySQL
Backend -[hidden]down- ChromaDB

User -[hidden]right- WebUser
WebUser -[hidden]right- Backend
Backend -[hidden]right- WebAdmin
WebAdmin -[hidden]right- Admin

' Connections
User <--> WebUser
WebAdmin <--> Admin

WebUser -right-> Backend : Request
Backend -left-> WebUser : Response

WebAdmin -left-> Backend : Request
Backend -right-> WebAdmin : Response

Backend -up-> AIServer : Request
AIServer -down-> Backend : Response

Backend <--> Gemini : GenAI
Backend <--> Gmail : Send Email

Backend <--> MySQL : Read/Write
Backend <--> ChromaDB : Vector Search

@enduml
