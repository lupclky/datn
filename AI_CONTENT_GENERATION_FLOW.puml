@startuml
title Luồng Generate Content (Product Description & News)

actor Admin
participant "Frontend\n(Angular)" as FE
participant "AiService" as ServiceFE
participant "AIChatController" as Controller
participant "Gemini Model" as AI

== 1. Generate Product Description ==
Admin -> FE: Nhập Tên SP, Chọn Danh mục, Tính năng
Admin -> FE: Click "Generate Description"
FE -> ServiceFE: generateProductDescription(name, cat, features)
ServiceFE -> Controller: POST /generate-product-description
note right of ServiceFE
Body: {
  "productName": "...",
  "category": "...",
  "features": "..."
}
end note

activate Controller
Controller -> Controller: createProductDescriptionPrompt()
note right of Controller
Prompt: "Bạn là chuyên gia copywriter...
Viết mô tả cho sản phẩm [Name]..."
end note

Controller -> AI: chat(prompt)
activate AI
AI --> Controller: Generated Description (Text)
deactivate AI

Controller --> ServiceFE: { "content": "...", "success": true }
deactivate Controller

ServiceFE --> FE: Observable<Response>
FE -> FE: Update Form Control (Description)
FE -> Admin: Hiển thị thông báo thành công

== 2. Generate News Content ==
Admin -> FE: Nhập Tiêu đề, Chủ đề, Tóm tắt
Admin -> FE: Click "Generate Content"
FE -> ServiceFE: generateNewsContent(title, topic, keywords)
ServiceFE -> Controller: POST /generate-news
note right of ServiceFE
Body: {
  "title": "...",
  "topic": "...",
  "keywords": "..."
}
end note

activate Controller
Controller -> Controller: createNewsGenerationPrompt()
note right of Controller
Prompt: "Bạn là biên tập viên...
Viết bài báo về [Title]...
Yêu cầu: HTML format, >1000 từ..."
end note

Controller -> AI: chat(prompt)
activate AI
AI --> Controller: Generated Article (HTML)
deactivate AI

Controller --> ServiceFE: { "content": "<html>...", "success": true }
deactivate Controller

ServiceFE --> FE: Observable<Response>
FE -> FE: Update Editor Content (Quill)
FE -> Admin: Hiển thị bài viết đã tạo
@enduml
