					"name": "Chat Text",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"message\": \"Hello AI\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/ai/chat/text",
							"host": ["{{base_url}}"],
