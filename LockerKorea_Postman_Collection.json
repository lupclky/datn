							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"user_id\": 1,\n    \"fullname\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"phone_number\": \"0123456789\",\n    \"address\": \"123 Street\",\n    \"note\": \"\",\n    \"total_money\": 100000,\n    \"shipping_method\": \"express\",\n    \"payment_method\": \"cod\",\n    \"cart_items\": [\n        {\n            \"product_id\": 1,\n            \"quantity\": 2\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/orders",
							"host": ["{{base_url}}"],
							"path": ["orders"]
