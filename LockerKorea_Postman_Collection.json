				{
					"name": "Search Products (Vector)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/ai/search/products?query=shoes",
							"host": ["{{base_url}}"],
							"path": ["ai", "search", "products"],
							"query": [
