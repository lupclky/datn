								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/orders/user",
							"host": ["{{base_url}}"],
							"path": ["orders", "user"]
						}
					}
				}
			]
		},
